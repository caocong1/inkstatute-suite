    "/v1/runs/{run_id}/events": {
      "get": {
        "description": "Open an SSE stream for a run. Events are delivered in seq order. When Last-Event-ID header is present, buffered events with seq > last_event_id are replayed first, then live streaming continues.",
        "operationId": "streamRun",
        "parameters": [
          {
            "description": "Run identifier.",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Last event sequence number for reconnection replay.",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/RunEventFrame"
                }
              }
            },
            "description": "SSE stream of RunEvent frames. Each frame contains an event id, an event name, and a JSON data payload."
          },
          "401": {
            "content": {
              "application/json": {
                "examples": {
                  "sanitized": {
                    "code": "unauthorized",
                    "details": {},
