    "/v1/runs/{run_id}/events": {
      "get": {
        "operationId": "streamRun",
        "parameters": [
          {
            "description": "Identifier returned by createRun.",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/RunEventFrame"
                }
              }
            },
            "description": "SSE stream of sanitized RunEvent frames. Each frame contains an event id, an event name, and a JSON data payload. The stream ends with a run_completed frame."
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
