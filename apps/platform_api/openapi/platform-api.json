  "info": {
    "description": "Unified multi-tenant HTTP+SSE Gateway for InkStatute \u2014 the single client-facing entry point for all clients (web, desktop, WeCom, QQ, programmatic). Remote/thin: the gateway relays to ACP-speaking agent backends and never embeds a local runtime, queue, or database. Exposes sessions, runs, SSE streaming, elicitation, approvals, artifacts, uploads, feedback, and skills endpoints. Auth: RBAC Bearer token + session cookie. All examples and schema references are sanitized; no live payloads are accepted.",
    "title": "InkStatute Gateway API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/artifacts/{artifact_id}": {
      "get": {
        "description": "Retrieve artifact metadata by artifact_id. Returns a uri_ref (not raw content). Cross-tenant access returns 404. Reference-only: no raw content is stored or returned.",
        "operationId": "getArtifact",
        "parameters": [
          {
            "description": "Artifact identifier.",
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "sanitized": {
                    "summary": "Artifact response",
                    "value": {
                      "artifact_id": "artifact-example-001",
                      "kind": "trackchanges_docx",
                      "metadata": {},
                      "name": "contract_review.docx",
                      "reference_only": true,
                      "tenant_id": "tenant-example",
                      "uri_ref": "fixture://artifacts/artifact-example-001"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ArtifactResponse"
                }
              }
            },
            "description": "Successful response"
          },
          "401": {
            "content": {
              "application/json": {
                "examples": {
                  "sanitized": {
                    "code": "unauthorized",
                    "details": {},
                    "message": "Example error code: unauthorized"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error response"
          },
          "403": {
            "content": {
              "application/json": {
                "examples": {
                  "sanitized": {
                    "code": "tenant_mismatch",
                    "details": {},
                    "message": "Example error code: tenant_mismatch"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error response"
          },
          "404": {
            "content": {
              "application/json": {
                "examples": {
                  "sanitized": {
                    "code": "not_found",
                    "details": {},
                    "message": "Example error code: not_found"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SessionCookie": []
          }
        ],
        "summary": "Download an artifact by id.",
        "tags": [
          "Artifacts"
        ]
      }
    },
    "/v1/feedback": {
      "post": {
        "description": "Submit feedback (up/down/needs_fix/route_wrong) for a run or conversation. route_wrong feedback creates a SkillCandidate with requires_human_review=True (never auto-modified).",
