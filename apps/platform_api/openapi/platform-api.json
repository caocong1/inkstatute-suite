    "securitySchemes": {
      "PlatformApiSecret": {
        "description": "Reference token resolved by the host deployment. The OpenAPI document does not store secret values.",
        "in": "header",
        "name": "X-InkStatute-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Default-off thin host surface for the InkStatute RunRuntime. The host exposes remote/thin endpoints only and never embeds a local runtime, queue, or database. All examples and schema references are sanitized; no live WeCom, Hermes, or runtime payloads are accepted.",
    "title": "InkStatute Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/runs": {
      "post": {
        "description": "Submits a run to the injected RunRuntime. The body must include a validated AgentTurn shape and a SolutionBinding reference. The host does not perform network I/O, queueing, or storage beyond the injected runtime and contract log.",
        "operationId": "createRun",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "sanitized": {
                  "summary": "Sanitized create run request",
                  "value": {
                    "metadata": {
                      "request_id": "request-example-001"
                    },
                    "session_id": "session-example",
                    "solution": {
                      "backend_id": "fake-backend",
                      "config_ref": "fixture://solutions/lawyer-v1",
                      "solution_id": "lawyer-v1"
                    },
                    "tenant_id": "tenant-example",
                    "turn": {
                      "channel": "web",
                      "content": "fixture://turns/turn-example-001/content_ref",
                      "conversation_id": "conv-example-001",
                      "message_type": "text",
                      "metadata": {
                        "raw_payload_ref": "fixture://turns/turn-example-001/raw"
                      },
                      "received_at": "2026-06-29T00:00:00Z",
                      "turn_id": "turn-example-001",
                      "user_id": "user-example"
                    },
                    "workspace_id": "workspace-example"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "examples": {
                  "sanitized": {
                    "summary": "Sanitized run response",
                    "value": {
                      "metadata": {
                        "backend_id": "fake-backend",
                        "backend_run_id": "backend-run-example-001"
                      },
                      "result": null,
                      "run_id": "run-example-001",
                      "solution_id": "lawyer-v1",
                      "status": "succeeded",
                      "turn_id": "turn-example-001"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "sanitized": {
                    "code": "invalid_request",
                    "details": {
                      "request_id": "request-example-001"
                    },
                    "message": "Example error code: invalid_request"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error response"
          },
          "503": {
            "content": {
              "application/json": {
                "examples": {
                  "sanitized": {
                    "code": "platform_api_disabled",
                    "details": {
                      "request_id": "request-example-001"
                    },
                    "message": "Example error code: platform_api_disabled"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error response"
          }
        },
        "summary": "Create a run from an AgentTurn and a SolutionBinding.",
        "tags": [
          "runs"
        ]
      }
    },
