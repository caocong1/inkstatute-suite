# InkStatute local env example — copy to `.env` (gitignored). Never commit real secrets.
# Refs vs values: production hosts prefer *_REF; smoke --live uses value vars. See runbook/.

# --- Feature flags (all default OFF unless set) ---
# INKSTATUTE_QQBOT_CHANNEL_ENABLED=false
# INKSTATUTE_PLATFORM_API_ENABLED=false
# ADMIN_CONFIG_EDITORS_ENABLED=1
# admin_web_ui_enabled is typically set via RuntimeFeatureFlags, not raw env

# --- Admin Web UI and Admin Console API (Operator Config Console) ---
# Operator config pages; live acceptance gates remain manual.
# INKSTATUTE_ADMIN_WEB_UI_ENABLED=false
# INKSTATUTE_ADMIN_API_ENABLED=false
# INKSTATUTE_OPERATOR_CONFIG_ENABLED=false
# ADMIN_WEB_UI_HOST=127.0.0.1
# ADMIN_WEB_UI_PORT=8080
# ADMIN_WEB_UI_SECRET=replace-me-admin-web-ui-secret
# ADMIN_CONSOLE_API_HOST=127.0.0.1
# ADMIN_CONSOLE_API_PORT=8081
# ADMIN_CONSOLE_API_URL=http://127.0.0.1:8081
# ADMIN_CONSOLE_API_TOKEN=replace-me-admin-console-token
# RBAC_TOKEN_SECRET=replace-me-rbac-secret
# INKSTATUTE_CONTRACT_LOG_PATH=/path/to/runtime/events.jsonl
# INKSTATUTE_FEEDBACK_QUEUE_PATH=/path/to/runtime/feedback.jsonl
# INKSTATUTE_OPERATOR_CONFIG_PATH=/path/to/runtime/operator-config.json

# --- Reports dashboard (bounded tail-scan aggregation) ---
# REPORTS_MAX_SCAN_LINES=10000
# REPORTS_SCAN_LOOKBACK_SECONDS=86400
# REPORTS_LONG_TASK_THRESHOLD_SECONDS=60
# INKSTATUTE_REPORT_DISPLAY_TZ=UTC

# --- QQBot host (production-style refs; values resolved at process edge) ---
# INKSTATUTE_QQBOT_CHANNEL_ENABLED=true
# QQBOT_HOST_HOST=127.0.0.1
# QQBOT_HOST_PORT=8080
# INKSTATUTE_QQBOT_APP_ID_REF=secret://qqbot/app-id
# INKSTATUTE_QQBOT_APP_SECRET_REF=secret://qqbot/app-secret
# INKSTATUTE_QQBOT_TOKEN_SECRET_REF=secret://qqbot/token
# INKSTATUTE_QQBOT_BOT_SECRET_REF=secret://qqbot/bot-secret
# Values for secret:// resolution (host process only):
# INKSTATUTE_QQBOT_APP_ID=
# INKSTATUTE_QQBOT_CLIENT_SECRET=
# INKSTATUTE_QQBOT_TOKEN=
# INKSTATUTE_QQBOT_BOT_SECRET=

# --- QQBot smoke --live (value env; HUMAN GATE; not the same as host *_REF) ---
# INKSTATUTE_QQBOT_APP_ID=
# INKSTATUTE_QQBOT_CLIENT_SECRET=
# INKSTATUTE_QQBOT_BOT_SECRET=
# INKSTATUTE_QQBOT_USER_OPENID=
# INKSTATUTE_QQBOT_REPLY_MSG_ID=

# --- WeCom (InkStatute-owned service; fill when deploying wecom-service) ---
# INKSTATUTE_WECOM_CHANNEL_ENABLED=true
# WECOM_HOST_HOST=127.0.0.1
# WECOM_HOST_PORT=8082
# INKSTATUTE_WECOM_CORP_ID=
# INKSTATUTE_WECOM_AGENT_ID=
# INKSTATUTE_WECOM_TOKEN=
# INKSTATUTE_WECOM_ENCODING_AES_KEY=
# INKSTATUTE_WECOM_CORP_SECRET=

# --- Process orchestration (Phase 80) ---
# INKSTATUTE_PROCESS_STATE_PATH=/path/to/runtime/process-state.json
# INKSTATUTE_PROCESS_LOG_DIR=/path/to/runtime/process-logs

# --- Log viewing (Phase 82) ---
# INKSTATUTE_RUNTIME_AUDIT_PATH=/path/to/runtime/runtime-audit.jsonl
# LOG_VIEWER_MAX_LINES=500

# --- Provider / model (InkStatute provider_model path — NOT Hermes ~/.hermes) ---
# OpenAI-compatible example (Ollama Cloud):
# OLLAMA_API_KEY=
# INKSTATUTE_PROVIDER_API_BASE_URL=https://ollama.com/v1
# INKSTATUTE_PROVIDER_API_KEY_REF=OLLAMA_API_KEY
# INKSTATUTE_PROVIDER_MODEL=glm-5.2
# Optional dedicated vision / image-understanding model when main model has no vision:
# INKSTATUTE_VISION_API_BASE_URL=
# INKSTATUTE_VISION_API_KEY_REF=
# INKSTATUTE_VISION_MODEL=
# INKSTATUTE_VISION_ROUTING=auto
#   auto  = if inbound has image and main model lacks vision → vision model then main
#   always = always run vision model on image turns
#   never  = never call vision model (multimodal main only / drop images per policy)
