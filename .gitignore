# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
apps/web/test-results/
apps/web/playwright-report/

# Engine release archives (172MB+ binaries — use scripts/build_dsh_release.sh to produce)
engines/releases/*.zip
# Root-level engine-manifest.json is a copy for gate validation; canonical is engines/releases/engine-manifest.json
engines/engine-manifest.json
# Temporary fix scripts (not part of the codebase)
tmp_fix_*.cjs
tmp_fix_*.js
# Deck build scratch (officecli slide exports + build batches); deliverables and build_deck.py live outside the repo
tmp_pptx_build/
/s[0-9][0-9].html
