{
  "bundle_id": "lawfirm-profile-bundle",
  "bundle_version": "0.1.0",
  "profile_name": "lawfirm",
  "structure_refs": [
    "profile-layout-template",
    "hooks-template",
    "skills-index-template",
    "mcp-config-template",
    "scripts-template",
    "soul-template",
    "agent-config-template"
  ],
  "hook_artifacts": [
    "response_filter_contract_result_recorder"
  ],
  "adapter_config": {
    "mode": "hermes",
    "manifest_builder": "hermes_contract_layer.adapter_manifest.build_hermes_adapter_manifest",
    "ordinary_wecom_channel_owner": "inkstatute_wecom_service",
    "channel_io": "disabled_for_adapter"
  },
  "external_env_names": [
    "INKSTATUTE_CONTRACT_LOG_PATH",
    "INKSTATUTE_WECOM_CREDENTIAL_REF",
    "HERMES_MODEL_CREDENTIAL_REF",
    "LAWFIRM_PROFILE_CREDENTIAL_REF"
  ],
  "source_status": "sanitized_manifest_only",
  "runtime_material_policy": {
    "repo_contains_runtime_values": false,
    "repo_contains_raw_values": false,
    "repo_contains_private_documents": false,
    "repo_contains_binary_uploads": false
  }
}
