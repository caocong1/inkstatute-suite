{
  "name": "@inkstatute/platform-sdk-ts",
  "version": "0.1.0",
  "description": "Remote/thin TypeScript SDK generated from the InkStatute platform API OpenAPI document.",
  "note": "v5.0: only src/events.ts is live; src/index.ts (HTTP client) is frozen.",
  "license": "Proprietary",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./events": {
      "import": "./src/events.ts",
      "require": "./src/events.ts",
      "types": "./src/events.ts"
    }
  },
  "scripts": {
    "generate": "python scripts/generate_sdk.py --openapi ../../apps/platform_api/openapi/platform-api.json --out src/index.ts"
  },
  "files": [
    "src",
    "scripts",
    "README.md"
  ]
}
