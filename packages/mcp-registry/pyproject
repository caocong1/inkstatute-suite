[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "inkstatute-mcp-registry"
version = "0.1.0"
description = "Read-only MCP Connector Registry with cursor pagination, versioning, and soft-delete."
requires-python = ">=3.11"
dependencies = []

[tool.setuptools.packages.find]
where = ["src"]

[tool.inkstatute]
subsystem = "mcp-registry"
default_off_flag = "mcp_registry_enabled"
