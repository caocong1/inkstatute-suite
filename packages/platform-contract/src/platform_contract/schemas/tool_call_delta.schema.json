{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstatute.dev/schemas/platform-contract/tool_call_delta.schema.json",
  "title": "ToolCallDeltaPayload",
  "description": "Payload for the tool_call.delta unified event (ACP tool_call_update).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "tool_call_id"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "const": "tool_call.delta"
    },
    "tool_call_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed"
      ]
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    }
  }
}
