{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstatute.dev/schemas/platform-contract/run_step.schema.json",
  "title": "RunStep",
  "description": "Neutral record for one observable step in a run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "run_id",
    "kind",
    "status",
    "started_at"
  ],
  "properties": {
    "step_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/run_step_kind"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/async_task_state"
    },
    "title": {
      "type": "string"
    },
    "input_ref": {
      "type": "string"
    },
    "output_ref": {
      "type": "string"
    },
    "tool_call_id": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "ended_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "error": {
      "$ref": "common.schema.json#/$defs/error_info"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    }
  }
}
