{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstatute.dev/schemas/platform-contract/common.schema.json",
  "title": "InkStatute Platform Contract Shared Definitions",
  "type": "object",
  "$defs": {
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "industry_context": {
      "type": "object",
      "additionalProperties": true
    },
    "async_task_state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_for_user",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "error_category": {
      "type": "string",
      "enum": [
        "contract_error",
        "runtime_error",
        "channel_error"
      ]
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "rejected",
        "expired",
        "cancelled"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "wecom",
        "qqbot",
        "web",
        "desktop"
      ]
    },
    "channel_delivery_status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "delivered",
        "failed",
        "suppressed"
      ]
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "file",
        "image",
        "voice",
        "button_callback"
      ]
    },
    "agent_result_status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked",
        "needs_clarification"
      ]
    },
    "reply_type": {
      "type": "string",
      "enum": [
        "text",
        "markdown",
        "file",
        "card",
        "status_update"
      ]
    },
    "artifact_kind": {
      "type": "string",
      "enum": [
        "docx",
        "pptx",
        "trackchanges_docx",
        "xlsx",
        "pdf",
        "markdown",
        "json",
        "other"
      ]
    },
    "run_event_type": {
      "type": "string",
      "enum": [
        "state_changed",
        "step_started",
        "step_completed",
        "message_delta",
        "tool_call_started",
        "tool_call_completed",
        "approval_requested",
        "artifact_created",
        "error",
        "session.started",
        "message.delta",
        "message.completed",
        "thought.delta",
        "tool_call.started",
        "tool_call.delta",
        "tool_call.completed",
        "plan.updated",
        "phase.changed",
        "elicitation.requested",
        "permission.requested",
        "artifact.created",
        "citation.recorded",
        "run.state_changed",
        "arena.workflow_started",
        "arena.workflow_completed",
        "arena.score_recorded",
        "arena.review_completed",
        "arena.synthesis_started",
        "arena.synthesis_completed",
        "arena.adversarial_challenge_completed",
        "arena.early_stop_triggered"
      ]
    },
    "run_step_kind": {
      "type": "string",
      "enum": [
        "model",
        "tool",
        "approval",
        "delivery",
        "system"
      ]
    },
    "feedback_source": {
      "type": "string",
      "enum": [
        "card_button",
        "text_command",
        "web_form",
        "admin_annotation"
      ]
    },
    "feedback_event_type": {
      "type": "string",
      "enum": [
        "rating",
        "correction",
        "fact_missing",
        "citation_error",
        "route_mismatch",
        "format_issue",
        "compliance_issue",
        "skill_candidate"
      ]
    },
    "feedback_action": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "needs_fix",
        "route_wrong"
      ]
    },
    "feedback_status": {
      "type": "string",
      "enum": [
        "pending",
        "triaged",
        "resolved",
        "dismissed"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "skill_candidate_source": {
      "type": "string",
      "enum": [
        "route_mismatch",
        "repeated_feedback",
        "unknown_task"
      ]
    },
    "route_mode": {
      "type": "string",
      "enum": [
        "matched",
        "simple_qa",
        "skipped",
        "zero_match"
      ]
    },
    "language_register": {
      "type": "string",
      "enum": [
        "formal",
        "colloquial"
      ]
    },
    "secret_ref": {
      "type": "string",
      "description": "Reference to externally managed secret material. Plaintext secret values must not be stored in contract payloads.",
      "minLength": 1
    },
    "solution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solution_id",
        "backend_id"
      ],
      "properties": {
        "solution_id": {
          "type": "string"
        },
        "backend_id": {
          "type": "string"
        },
        "manifest_ref": {
          "type": "string"
        },
        "materialization_ref": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "neutral_skill_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "name"
      ],
      "properties": {
        "skill_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "input_schema_ref": {
          "type": "string"
        },
        "output_schema_ref": {
          "type": "string"
        },
        "required_tool_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "mcp_server_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_id",
        "name",
        "transport"
      ],
      "properties": {
        "server_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "capability_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/secret_ref"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "attachment_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment_id",
        "kind",
        "uri"
      ],
      "properties": {
        "attachment_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "output_constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "docx",
            "pptx",
            "xlsx",
            "pdf",
            "markdown",
            "text",
            "json",
            "card",
            "other"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "template_ref": {
          "type": "string"
        },
        "citation_style": {
          "type": "string"
        },
        "language_register": {
          "$ref": "#/$defs/language_register"
        },
        "must_cite": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "name",
        "uri"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/artifact_kind"
        },
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "template_ref": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "skill_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected",
        "source"
      ],
      "properties": {
        "detected": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/skill_candidate_source"
        },
        "proposed_name": {
          "type": "string"
        },
        "risk_level": {
          "$ref": "#/$defs/risk_level"
        },
        "requires_human_review": {
          "type": "boolean",
          "default": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "error_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/error_category"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "$ref": "#/$defs/metadata"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    }
  }
}
