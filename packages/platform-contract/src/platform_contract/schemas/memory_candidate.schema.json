{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstatute.dev/schemas/platform-contract/memory_candidate.schema.json",
  "title": "MemoryCandidate",
  "description": "Proposed memory change awaiting policy and, when needed, human review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "tenant_id",
    "workspace_id",
    "status",
    "source_refs",
    "created_at"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suppressed"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "proposed_scope": {
      "type": "string",
      "enum": [
        "session",
        "user",
        "workspace",
        "tenant"
      ]
    },
    "proposed_sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "proposed_action": {
      "type": "string"
    },
    "memory_id": {
      "type": "string"
    },
    "proposed_record_ref": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_human_review": {
      "type": "boolean",
      "default": true
    },
    "raw_payload_ref": {
      "type": "string"
    },
    "industry_context": {
      "$ref": "common.schema.json#/$defs/industry_context"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    }
  }
}
