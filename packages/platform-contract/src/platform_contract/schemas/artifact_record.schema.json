{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstatute.dev/schemas/platform-contract/artifact_record.schema.json",
  "title": "ArtifactRecord",
  "description": "Top-level artifact reference record. This does not replace AgentResult.artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "run_id",
    "kind",
    "name",
    "uri",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "result_id": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/artifact_kind"
    },
    "name": {
      "type": "string"
    },
    "uri": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "checksum": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    }
  }
}
