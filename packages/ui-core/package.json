{
  "name": "@inkstatute/ui-core",
  "version": "0.1.0",
  "description": "Shared SolidJS component package \u2014 single chat UI implementation for all clients.",
  "license": "Proprietary",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./themes": "./src/themes/index.ts",
    "./events": "./src/types/events.ts",
    "./ui-core.css": "./dist/ui-core.css"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0",
    "solid-markdown": ">=0.1.0",
    "remark-gfm": ">=4.0.0",
    "highlight.js": ">=11.0.0"
  },
  "dependencies": {
    "@inkstatute/platform-sdk-ts": "workspace:*"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.0.0",
    "highlight.js": ">=11.0.0",
    "jsdom": "^25.0.0",
    "remark-gfm": ">=4.0.0",
    "solid-js": "^1.9.0",
    "solid-markdown": ">=0.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.0.0"
  }
}
